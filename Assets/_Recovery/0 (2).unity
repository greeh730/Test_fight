    negativeEffectText: "-15% \u043A \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0440\u0435\u0433\u0435\u043D\u0430 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438"
