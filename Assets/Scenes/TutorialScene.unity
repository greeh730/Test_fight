  explosionFailPool:
    sourcePhrases:
    - "\u041B\u044E\u0431\u0438\u0448\u044C \u0432\u0437\u0440\u044B\u0432\u044B?"
    - "\u041F\u043E\u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0439."
    - "\u0421\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C - \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430."
    - "\u041D\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0431\u043E\u043B\u044C?"
    - "\u0410 \u043C\u043E\u0436\u0435\u0442 \u043C\u043D\u0435 \u043D\u0430\u0439\u0442\u0438 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0433\u0435\u0440\u043E\u044F\u2026"
    - "\u041E\u0448\u0438\u0431\u0430\u0442\u044C\u0441\u044F - \u044D\u0442\u043E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E. \u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u0434\u0435\u043B\u0430\u0442\u044C \u0432\u044B\u0432\u043E\u0434\u044B."
    - "\u0412\u043E\u0442 \u0435\u0449\u0451 \u0447\u0443 \u0447\u0443\u0442\u044C \u0438 \u044F \u0432 \u0442\u0435\u0431\u044F \u0443\u0432\u0435\u0440\u0443\u044E."
    - "\u041D\u0435\u0442, \u043D\u0443 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438 \u043E\u0433\u043E\u043D\u044C \u0442\u044B \u043F\u0440\u0438\u0437\u0432\u0430\u043B."
