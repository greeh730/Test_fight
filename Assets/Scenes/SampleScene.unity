    playerStaminaDelta: 0
    playerStaminaRegenMult: 1
    playerDamageMult: 1
    playerSpeedMult: 1
    enemyHealthMult: 1
    enemySpeedMult: 1
  - id: tac_trap
    title: "\u0413\u043B\u0443\u0431\u0438\u043D\u043D\u0430\u044F \u043F\u0435\u0447\u0430\u0442\u044C"
    category: 0
    iconSymbol: "\u2B07\uFE0F"
    description: "\u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u043D\u0430\u0436\u0438\u043C\u043D\u0443\u044E \u0440\u0443\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u043C\u0438\u043D\u0443 \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438. \u041D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043D \u0438 \u043F\u0430\u0440\u0430\u043B\u0438\u0437\u0443\u0435\u0442 \u0432\u0440\u0430\u0433\u0430 \u043D\u0430 1.5 \u0441\u0435\u043A."
