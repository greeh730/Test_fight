  tacticianCards:
  - id: tac_thrust
    title: "\u041F\u0440\u043E\u0449\u0443\u043F\u044B\u0432\u0430\u044E\u0449\u0438\u0439 \u0432\u044B\u043F\u0430\u0434"
    category: 0
    iconSymbol: "\u27A1\uFE0F"
    description: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u043A\u043E\u043B\u044E\u0449\u0438\u0439 \u0432\u044B\u043F\u0430\u0434 \u0432\u043F\u0435\u0440\u0435\u0434. \u0412\u0435\u0448\u0430\u0435\u0442 \u043C\u0435\u0442\u043A\u0443 \u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u0438 \u043D\u0430 \u0432\u0440\u0430\u0433\u0430 (+35% \u0443\u0440\u043E\u043D\u0430 \u043D\u0430 7 \u0441\u0435\u043A)."
    positiveEffectText: "\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u27A1\uFE0F \u0432 \u0441\u0442\u043E\u0439\u043A\u0435 \u0422\u0430\u043A\u0442\u0438\u043A\u0430"
    negativeEffectText: 
    abilityDirection: 0
