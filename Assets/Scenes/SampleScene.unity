    negativeEffectText: "\u0412\u0440\u0430\u0433\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 +30% \u043A \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u043C\u0443 HP"
