  m_Text: "<color=#00E5FF><b>[ \u041B\u041A\u041C (\u0417\u0430\u0436\u0430\u0442\u0438\u0435 \u0438 \u0432\u044B\u0447\u0435\u0440\u0447\u0438\u0432\u0430\u043D\u0438\u0435 \u0436\u0435\u0441\u0442\u0430) ]</b></color>\n\u0412\u044B\u0447\u0435\u0440\u0447\u0438\u0432\u0430\u043D\u0438\u0435 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 \u0432\u043D\u0443\u0442\u0440\u0438 \u0412\u0435\u043A\u0442\u043E\u0440\u043D\u043E\u0433\u043E \u041A\u043E\u043B\u0435\u0441\u0430. \u041E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0435 \u0441\u0432\u0430\u0439\u043F\u044B \u043D\u0435 \u0430\u0442\u0430\u043A\u0443\u044E\u0442 \u0432\u0445\u043E\u043B\u043E\u0441\u0442\u0443\u044E \u2014 \u0443\u0434\u0430\u0440\u044B \u043D\u0430\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u0441\u0442\u0440\u043E\u0433\u043E \u0447\u0435\u0440\u0435\u0437 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438 \u0438 \u043C\u043E\u0443\u0448\u043D-\u0441\u0432\u044F\u0437\u043A\u0438 \u0438\u0437 8 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439 (\u0441\u043C. \u0432\u043A\u043B\u0430\u0434\u043A\u0443 \xAB\u0421\u043F\u0438\u0441\u043E\u043A \u043F\u0440\u0438\u0451\u043C\u043E\u0432\xBB).\n\n<color=#00E5FF><b>[ \u041F\u041A\u041C (\u0417\u0430\u0436\u0430\u0442\u0438\u0435 \u0438 \u0432\u044B\u0431\u043E\u0440 \u0441\u0435\u043A\u0442\u043E\u0440\u0430) ]</b></color>\n\u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0438 \u043F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u0430\u0442\u0430\u043A \u0432\u0440\u0430\u0433\u0430. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0435\u043A\u0442\u043E\u0440 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u043E\u0442\u043A\u0443\u0434\u0430 \u043B\u0435\u0442\u0438\u0442 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0439 \u0443\u0434\u0430\u0440, \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u041F\u041A\u041C \u0432 \u043C\u043E\u043C\u0435\u043D\u0442 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0430. \u0423\u0441\u043F\u0435\u0448\u043D\u043E\u0435 \u043F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0438 \u0438\u0441\u0442\u043E\u0449\u0430\u0435\u0442 \u0435\u0433\u043E \u0448\u043A\u0430\u043B\u0443 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438.\n\n<color=#00E5FF><b>[ \u041B\u0435\u0432\u044B\u0439 Ctrl ] \u2014 \u0421\u043C\u0435\u043D\u0430 \u0431\u043E\u0435\u0432\u043E\u0439 \u0441\u0442\u043E\u0439\u043A\u0438:</b></color>\n  \u2022 <color=#FF4444><b>\u0411\u041E\u0415\u0412\u0410\u042F \u0421\u0422\u041E\u0419\u041A\u0410 (\u041A\u041B\u0418\u041D\u041E\u041A):</b></color> \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0440\u0443\u0431\u044F\u0449\u0438\u0445 \u0441\u0432\u044F\u0437\u043E\u043A, \u043F\u0440\u043E\u0432\u0435\u0440\u043E\u0447\u043D\u044B\u0445 \u0432\u044B\u043F\u0430\u0434\u043E\u0432 \u0438 \u0444\u0438\u043D\u0438\u0448\u0435\u0440\u043E\u0432 \u043A\u043B\u0438\u043D\u043A\u043E\u043C.\n  \u2022 <color=#00E5FF><b>\u0421\u0422\u041E\u0419\u041A\u0410 \u0422\u0410\u041A\u0422\u0418\u041A\u0410 (\u041C\u0410\u0413\u0418\u042F \u041A\u0420\u0418\u0421\u0422\u0410\u041B\u041B\u0410):</b></color> \u0441\u0432\u0430\u0439\u043F\u044B \u043A\u043E\u043B\u0435\u0441\u0430 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u044E\u0442 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F \u0430\u0440\u0435\u043D\u044B (\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430, \u0411\u0430\u0440\u044C\u0435\u0440, \u0413\u0440\u0430\u0432\u0438-\u0432\u043E\u0440\u043E\u043D\u043A\u0430, \u0423\u0434\u0430\u0440\u043D\u0430\u044F \u0432\u043E\u043B\u043D\u0430 \u0438 \u0434\u0440.).\n\n<color=#00E5FF><b>[ ESC ]</b></color>\n\u041C\u0435\u043D\u044E \u043F\u0430\u0443\u0437\u044B: \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0431\u043E\u0439, \u0431\u044B\u0441\u0442\u0440\u043E\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435, \u0431\u044B\u0441\u0442\u0440\u0430\u044F \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0430, \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043E\u0432 \u0438 \u0432\u044B\u0445\u043E\u0434 \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E.\n\n<color=#00E5FF><b>[ R ]</b></color>\n\u041C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u043A \u0430\u0440\u0435\u043D\u044B \u043F\u0440\u0438 \u0433\u0438\u0431\u0435\u043B\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430."
