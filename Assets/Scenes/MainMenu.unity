  m_Text: "<color=#FF3355><b>1. \u0412\u041E\u0421\u0425\u041E\u0414\u042F\u0429\u0418\u0419 \u0412\u0418\u0425\u0420\u042C \u26A1 (\u0421\u0423\u041F\u0415\u0420-\u0424\u0418\u041D\u0418\u0428\u0415\u0420)</b></color>\n  \u2022 <b>\u0412\u043F\u0440\u0430\u0432\u043E:</b> <color=#FFD700><b>\u2199 \u2193 \u2198 \u2192 \u2197</b></color>   |   <b>\u0412\u043B\u0435\u0432\u043E:</b> <color=#FFD700><b>\u2198 \u2193 \u2199 \u2190 \u2196</b></color>\n  \u2022 <b>\u041A\u0430\u043A \u0441\u0434\u0435\u043B\u0430\u0442\u044C:</b> \u0417\u0430\u0436\u043C\u0438\u0442\u0435 \u041B\u041A\u041C \u0438 \u043F\u043B\u0430\u0432\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435 \u0434\u0443\u0433\u0443 \u043F\u043E \u043D\u0438\u0436\u043D\u0435\u043C\u0443 \u043F\u043E\u043B\u0443\u043A\u0440\u0443\u0433\u0443 \u0432\u0432\u0435\u0440\u0445 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0443\u0434\u0430\u0440\u0430.\n  \u2022 <b>\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B:</b> \u0423\u0440\u043E\u043D: <b>38</b> | \u0417\u043E\u043D\u044B: \u0421\u0440\u0435\u0434\u043D\u044F\u044F + \u0412\u0435\u0440\u0445\u043D\u044F\u044F | \u0412\u044B\u043F\u0430\u0434: 5.5 | <color=#FFD700><b>\u041F\u043E\u0434\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u0430 \u0432 \u0432\u043E\u0437\u0434\u0443\u0445 (Launcher)</b></color> \u043F\u0440\u0438 \u0438\u0441\u0442\u043E\u0449\u0435\u043D\u0438\u0438 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438.\n\n<color=#FF6622><b>2. \u041F\u0420\u041E\u041D\u0417\u0410\u042E\u0429\u0418\u0419 \u0428\u0422\u041E\u0420\u041C \U0001F4A5 (\u0421\u0418\u041B\u041E\u0412\u041E\u0419 \u0412\u042B\u041F\u0410\u0414)</b></color>\n  \u2022 <b>\u0412\u043F\u0440\u0430\u0432\u043E:</b> <color=#FFD700><b>\u2198 \u2192 \u2197</b></color>   |   <b>\u0412\u043B\u0435\u0432\u043E:</b> <color=#FFD700><b>\u2199 \u2190 \u2196</b></color>\n  \u2022 <b>\u041A\u0430\u043A \u0441\u0434\u0435\u043B\u0430\u0442\u044C:</b> \u0421\u0432\u0430\u0439\u043F \u0438\u0437 \u043D\u0438\u0436\u043D\u0435\u0433\u043E \u0441\u0435\u043A\u0442\u043E\u0440\u0430 \u0432\u043F\u0435\u0440\u0435\u0434 \u0438 \u0432\u0432\u0435\u0440\u0445.\n  \u2022 <b>\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B:</b> \u0423\u0440\u043E\u043D: <b>32</b> | \u0417\u043E\u043D\u0430: \u0421\u0440\u0435\u0434\u043D\u044F\u044F | \u0421\u0438\u043B\u0430 \u0432\u044B\u043F\u0430\u0434\u0430: 6.8 (\u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0434\u0430\u043B\u044C\u043D\u0438\u0439 \u0440\u044B\u0432\u043E\u043A \u0432\u043F\u0435\u0440\u0435\u0434).\n\n<color=#FFAA00><b>3. \u0412\u0415\u0420\u0425\u041D\u0418\u0415 \u0418 \u0414\u0418\u0410\u0413\u041E\u041D\u0410\u041B\u042C\u041D\u042B\u0415 \u0410\u0422\u0410\u041A\u0418</b></color>\n  \u2022 <b>\u0412\u0435\u0440\u0445\u043D\u0438\u0439 \u0440\u0443\u0431\u044F\u0449\u0438\u0439 \u25B2:</b> <color=#FFD700><b>\u2193 \u2191</b></color> \u2014 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0432\u0430\u0439\u043F \u0441\u043D\u0438\u0437\u0443-\u0432\u0432\u0435\u0440\u0445 (\u0423\u0440\u043E\u043D: 26 | \u0417\u043E\u043D\u044B: \u0412\u0435\u0440\u0445 + \u041C\u0438\u0434 | \u0412\u044B\u043F\u0430\u0434: 2.8 | \u0421\u0431\u0438\u0432\u0430\u0435\u0442 \u043F\u0440\u044B\u0436\u043A\u0438)\n  \u2022 <b>\u0414\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0440\u0435\u0437 \u2197:</b> <color=#FFD700><b>\u2199 \u2197</b></color> \u2014 \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0440\u0435\u0437 \u0441\u043D\u0438\u0437\u0443-\u0441\u043B\u0435\u0432\u0430 \u0432\u0432\u0435\u0440\u0445-\u0432\u043F\u0440\u0430\u0432\u043E (\u0423\u0440\u043E\u043D: 26 | \u0412\u044B\u043F\u0430\u0434: 3.2)\n  \u2022 <b>\u0414\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0440\u0435\u0437 \u2196:</b> <color=#FFD700><b>\u2198 \u2196</b></color> \u2014 \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0440\u0435\u0437 \u0441\u043D\u0438\u0437\u0443-\u0441\u043F\u0440\u0430\u0432\u0430 \u0432\u0432\u0435\u0440\u0445-\u0432\u043B\u0435\u0432\u043E (\u0423\u0440\u043E\u043D: 26 | \u0412\u044B\u043F\u0430\u0434: 3.2)\n\n<color=#00E5FF><b>4. \u0412\u042B\u041F\u0410\u0414\u042B \u041A\u041B\u0418\u041D\u041A\u041E\u041C (\u041F\u0420\u041E\u0412\u0415\u0420\u041E\u0427\u041D\u042B\u0415 \u0423\u041A\u041E\u041B\u042B)</b></color>\n  \u2022 <b>\u0412\u044B\u043F\u0430\u0434 \u043A\u043B\u0438\u043D\u043A\u043E\u043C \u25B6 (\u0432\u043F\u0440\u0430\u0432\u043E):</b> <color=#FFD700><b>\u2190 \u2192</b></color> \u2014 \u043E\u0442\u0442\u044F\u0436\u043A\u0430 \u043D\u0430\u0437\u0430\u0434 \u0441 \u0431\u044B\u0441\u0442\u0440\u044B\u043C \u0432\u044B\u0431\u0440\u043E\u0441\u043E\u043C \u0432\u043F\u0435\u0440\u0435\u0434 (\u0423\u0440\u043E\u043D: 22 | \u0417\u043E\u043D\u0430: \u0421\u0440\u0435\u0434\u043D\u044F\u044F | \u0412\u044B\u043F\u0430\u0434: 4.2)\n  \u2022 <b>\u0412\u044B\u043F\u0430\u0434 \u043A\u043B\u0438\u043D\u043A\u043E\u043C \u25C0 (\u0432\u043B\u0435\u0432\u043E):</b> <color=#FFD700><b>\u2192 \u2190</b></color> \u2014 \u043E\u0442\u0442\u044F\u0436\u043A\u0430 \u0432\u043F\u0435\u0440\u0435\u0434 \u0441 \u0431\u044B\u0441\u0442\u0440\u044B\u043C \u0432\u044B\u0431\u0440\u043E\u0441\u043E\u043C \u043D\u0430\u0437\u0430\u0434 (\u0423\u0440\u043E\u043D: 22 | \u0417\u043E\u043D\u0430: \u0421\u0440\u0435\u0434\u043D\u044F\u044F | \u0412\u044B\u043F\u0430\u0434: 4.2)\n\n<color=#33CCFF><b>5. \u041D\u0418\u0416\u041D\u0418\u0415 \u041F\u041E\u0414\u0421\u0415\u0427\u041A\u0418 \u0418 \u0421\u0420\u0415\u0417\u042B</b></color>\n  \u2022 <b>\u041D\u0438\u0436\u043D\u044F\u044F \u043F\u043E\u0434\u0441\u0435\u0447\u043A\u0430 \u25BC:</b> <color=#FFD700><b>\u2191 \u2193</b></color> \u2014 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0440\u0435\u0437 \u0441\u0432\u0435\u0440\u0445\u0443-\u0432\u043D\u0438\u0437 \u043F\u043E \u043D\u043E\u0433\u0430\u043C (\u0423\u0440\u043E\u043D: 20 | \u0417\u043E\u043D\u0430: \u041D\u0438\u0436\u043D\u044F\u044F | \u0412\u044B\u043F\u0430\u0434: 3.5)\n  \u2022 <b>\u041D\u0438\u0437\u043A\u0438\u0439 \u0441\u0440\u0435\u0437 \u2198 (\u0432\u043F\u0440\u0430\u0432\u043E):</b> <color=#FFD700><b>\u2196 \u2198</b></color> \u2014 \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0440\u0435\u0437 \u0441\u0432\u0435\u0440\u0445\u0443-\u0432\u043D\u0438\u0437 \u0432\u043F\u0440\u0430\u0432\u043E (\u0423\u0440\u043E\u043D: 20 | \u0417\u043E\u043D\u0430: \u041D\u0438\u0436\u043D\u044F\u044F | \u0412\u044B\u043F\u0430\u0434: 3.5)\n  \u2022 <b>\u041D\u0438\u0437\u043A\u0438\u0439 \u0441\u0440\u0435\u0437 \u2199 (\u0432\u043B\u0435\u0432\u043E):</b> <color=#FFD700><b>\u2197 \u2199</b></color> \u2014 \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0440\u0435\u0437 \u0441\u0432\u0435\u0440\u0445\u0443-\u0432\u043D\u0438\u0437 \u0432\u043B\u0435\u0432\u043E (\u0423\u0440\u043E\u043D: 20 | \u0417\u043E\u043D\u0430: \u041D\u0438\u0436\u043D\u044F\u044F | \u0412\u044B\u043F\u0430\u0434: 3.5)"
